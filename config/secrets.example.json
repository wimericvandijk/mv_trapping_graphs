{
  "TRAPNZ_API_KEY": "<API_KEY>",
  "TRAPNZ_PROJECT_ID": "<project_id>",
  "queries": {
    "trap_list": {
      "type_name": "trapnz-projects:my-projects-traps",
      "output_file": "my-projects-traps.csv"
    },
    "recent_records": {
      "type_name": "trapnz-projects:my-projects-trap-records",
      "output_file": "my-projects-trap-records-recent.csv"
    },
    "all_records": {
      "type_name": "trapnz-projects:my-projects-trap-records",
      "output_file": "my-projects-trap-records.csv"
    },
    "custom_records_example": {
      "type_name": "trapnz-projects:my-projects-trap-records",
      "output_file": "my-projects-trap-records-custom.csv",
      "cql_filter": "record_date>='2025-01-01'"
    },
    "custom_url_example": {
      "url": "https://io.trap.nz/geo/trapnz-projects/wfs/<API_KEY>/<project_id>?service=WFS&version=2.0.0&request=GetFeature&typeName=trapnz-projects:my-projects-traps&outputFormat=CSV",
      "output_file": "my-projects-traps-custom.csv"
    }
  }
}